---

<section class="hero">
  <div class="hero__glow"></div>
  <div class="container hero__inner">
    <div class="hero__text">
      <div class="hero__badge reveal" data-i18n="hero.badge">
        <span class="hero__badge-dot" aria-hidden="true"></span>
        <span>Available for remote roles · US/EU timezone friendly</span>
      </div>
      <h1 class="hero__headline reveal reveal-delay-1" data-i18n="hero.headline">
        I ship enterprise mobile apps to 16K+ users.
      </h1>
      <p class="hero__subheadline reveal reveal-delay-2" data-i18n="hero.subheadline">
        Senior Mobile Developer · 5 production Flutter apps · Latam &rarr; World.
      </p>
      <div class="hero__ctas reveal reveal-delay-3">
        <a href="#cases" class="btn btn-primary" data-i18n="hero.cta.work">See my work</a>
        <a href="#contact" class="btn btn-outline" data-i18n="hero.cta.contact">Let's talk</a>
        <a href="/cv" class="btn btn-ghost">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          <span data-i18n="hero.cta.cv">Download CV</span>
        </a>
      </div>
      <div class="hero__social reveal reveal-delay-4">
        <a href="https://github.com/korbold" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
        </a>
        <a href="https://linkedin.com/in/korbold" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        </a>
        <a href="mailto:dmmarketingads@gmail.com" aria-label="Email">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
        </a>
      </div>
    </div>

    <figure class="hero__portrait reveal reveal-delay-2" aria-hidden="true">
      <div class="hero__portrait-frame">
        <img
          src="/danny.jpg"
          alt="Danny Barahona"
          width="896"
          height="1195"
          loading="eager"
          fetchpriority="high"
        />
        <span class="hero__portrait-vignette" aria-hidden="true"></span>
      </div>
      <span class="hero__portrait-corner" aria-hidden="true"></span>
    </figure>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding-top: var(--navbar-height);
  }

  .hero__glow {
    position: absolute;
    top: 20%;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(124, 58, 237, 0.15) 0%, rgba(6, 182, 212, 0.05) 50%, transparent 70%);
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  @media (min-width: 900px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    }
  }

  .hero__text {
    max-width: 640px;
    min-width: 0;
  }

  /* Portrait */
  .hero__portrait {
    position: relative;
    justify-self: center;
    width: 100%;
    max-width: 360px;
    margin: 0;
  }

  @media (min-width: 900px) {
    .hero__portrait {
      max-width: 420px;
      justify-self: end;
    }
  }

  .hero__portrait-frame {
    position: relative;
    aspect-ratio: 3 / 4;
    border-radius: 16px;
    overflow: hidden;
    background:
      linear-gradient(140deg,
        color-mix(in oklch, var(--color-accent) 18%, transparent),
        color-mix(in oklch, var(--color-secondary) 12%, transparent)
      ),
      var(--color-surface);
    box-shadow:
      0 1px 0 0 color-mix(in oklch, var(--color-text) 6%, transparent) inset,
      0 30px 60px -30px rgba(0, 0, 0, 0.6),
      0 8px 24px -12px rgba(124, 58, 237, 0.25);
    transition: transform 480ms var(--ease-out-quart);
  }

  .hero__portrait-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 18%;
    display: block;
    filter: saturate(0.95) contrast(1.02);
  }

  .hero__portrait-vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(120% 80% at 50% 0%, transparent 40%, rgba(13, 13, 15, 0.35) 100%),
      linear-gradient(180deg, transparent 60%, rgba(13, 13, 15, 0.55) 100%);
  }

  /* Subtle outer accent: 1px gradient ring + tiny corner mark */
  .hero__portrait-frame::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(140deg,
      color-mix(in oklch, var(--color-accent) 60%, transparent),
      transparent 40%,
      color-mix(in oklch, var(--color-secondary) 40%, transparent)
    );
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
            mask-composite: exclude;
    pointer-events: none;
  }

  .hero__portrait-corner {
    position: absolute;
    bottom: -10px;
    right: -10px;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: color-mix(in oklch, var(--color-accent) 92%, black 6%);
    box-shadow: 0 8px 24px -8px rgba(124, 58, 237, 0.55);
  }

  @media (hover: hover) and (pointer: fine) {
    .hero__portrait:hover .hero__portrait-frame {
      transform: translateY(-4px) rotate(-0.15deg);
    }
  }

  @media (max-width: 899px) {
    .hero__portrait {
      max-width: 280px;
      margin-bottom: 0.5rem;
      order: -1;
    }
    .hero__portrait-corner {
      width: 28px;
      height: 28px;
    }
  }

  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    padding: 0.4rem 0.85rem;
    margin-bottom: var(--space-lg);
    font-size: var(--font-size-xs);
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-secondary);
    background: rgba(6, 182, 212, 0.08);
    border: 1px solid rgba(6, 182, 212, 0.3);
    border-radius: var(--radius-full);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .hero__badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7);
    animation: hero-badge-pulse 2s infinite;
  }

  @keyframes hero-badge-pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7);
    }
    70% {
      box-shadow: 0 0 0 10px rgba(34, 197, 94, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(34, 197, 94, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__badge-dot {
      animation: none;
    }
  }

  .hero__headline {
    font-size: var(--font-size-4xl);
    font-weight: 700;
    line-height: 1.15;
    margin-bottom: var(--space-lg);
    background: linear-gradient(135deg, var(--color-text) 0%, var(--color-accent) 50%, var(--color-secondary) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  @media (min-width: 768px) {
    .hero__headline {
      font-size: var(--font-size-5xl);
    }
  }

  .hero__subheadline {
    font-size: var(--font-size-lg);
    color: var(--color-text-muted);
    margin-bottom: var(--space-xl);
    max-width: 600px;
  }

  .hero__ctas {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
    margin-bottom: var(--space-2xl);
  }

  .hero__social {
    display: flex;
    gap: var(--space-lg);
  }

  .hero__social a {
    color: var(--color-text-muted);
    transition: color var(--transition);
  }

  .hero__social a:hover {
    color: var(--color-accent);
  }
</style>
